# Vorlage fuer die lokale Konfiguration. Kopiere diese Datei zu ".env" und
# trage deine echten Werte ein. Die Datei ".env" wird NIE ins Git eingecheckt
# (siehe .gitignore). In diese Vorlage gehoeren nur Platzhalter, keine echten Schluessel.

# --- Sprachmodell (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-dein-key-hier
ANTHROPIC_MODEL=claude-sonnet-5

# --- Frontend (CORS) ---
# Kommagetrennte Liste erlaubter Frontend-Adressen. Lokal laeuft der
# Vite-Server auf Port 5173.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Jira (optional) ---
# Leer lassen, wenn der Jira-Push nicht genutzt wird.
JIRA_BASE_URL=https://deine-seite.atlassian.net
JIRA_EMAIL=deine-jira-mail@example.com
JIRA_API_TOKEN=dein-jira-token-hier
JIRA_PROJECT_KEY=DEIN-PROJEKTKUERZEL
